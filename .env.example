# مفتاح Gemini من Google AI Studio (يبقى في الخادم فقط). بدونه يعمل الشات بمحرك NLP المحلي.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
PORT=8787
# اختياري: نماذج الصوت والصور وصوت النطق (تُكتشف تلقائياً لو لم تُضبط)
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_VOICE=Kore
# اختياري: للاختبار بخادم وهمي (npm run mock:gemini) ضع GEMINI_BASE_URL=http://localhost:9999 و GEMINI_API_KEY=test
GEMINI_BASE_URL=
# اختياري: تقييد CORS لتطبيق الموبايل (الافتراضي *)
CORS_ORIGIN=
# عند بناء تطبيق الموبايل (Capacitor) ضع في ملف .env.production عنوان الخادم المنشور: VITE_API_BASE=https://your-server.onrender.com

# بديل/احتياط مجاني: مفتاح Groq من console.groq.com (دردشة Llama + تفريغ Whisper يفهم اللهجات). النطق يبقى بصوت المتصفح.
GROQ_API_KEY=
# المزوّد الأساسي لو الاتنين موجودين: gemini أو groq. لو أحدهما فشل (حصة مثلاً) يجرّب الآخر تلقائياً.
AI_PROVIDER=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_STT_MODEL=whisper-large-v3
